name: Motor de Inferencia Multimedia
on:
  workflow_dispatch: # Activa el boton manual en la interfaz de usuario

jobs:
  procesar_imagen:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar el codigo del repositorio
        uses: actions/checkout@v4

      - name: Inicializar entorno de Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Instalar librerias de comunicacion e imagen
        run: pip install huggingface_hub Pillow

      - name: Ejecutar script de inferencia en la nube
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
        run: python generador_ia.py

      - name: Confirmar y guardar imagen en el repositorio
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Manifestación visual completada con éxito"
